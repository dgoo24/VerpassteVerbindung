# Copia este archivo a ".env" y rellena tus credenciales.
# Fuente de datos: "db" (API DB Timetables, tiempo real) o "mock" (demo local).
DATA_SOURCE=db

# Credenciales del DB API Marketplace (aplicacion suscrita a Timetables - plan Free).
DB_CLIENT_ID=tu-client-id
DB_API_KEY=tu-client-secret

# Estacion a monitorizar.
DB_STATION_PATTERN=Fulda
DB_STATION_EVA=8000115
STATION_ID=FULDA_HBF

DB_REFRESH_SECONDS=30
DB_PLAN_HOURS_AHEAD=1
MIN_TRANSFER_TIME_MINUTES=7
MAX_CONNECTION_WINDOW_MINUTES=45
DEFAULT_ESTIMATED_TRAVELERS=80
